# ============================================================
# PLANTILLA de referencia (.NET 8). El repo del back ya trae su propio Dockerfile;
# caminoSeguroBack con el nombre "Dockerfile".
# Cambiar APP_NAME por el nombre del proyecto (el .csproj sin extensión).
# ============================================================
FROM mcr.microsoft.com/dotnet/sdk:8.0 AS build
ARG APP_NAME=CaminoSeguro.Api
WORKDIR /src

# Primero solo el .csproj para aprovechar la caché de "restore".
COPY ${APP_NAME}/${APP_NAME}.csproj ${APP_NAME}/
RUN dotnet restore ${APP_NAME}/${APP_NAME}.csproj

COPY . .
RUN dotnet publish ${APP_NAME}/${APP_NAME}.csproj -c Release -o /app/publish --no-restore

FROM mcr.microsoft.com/dotnet/aspnet:8.0
ARG APP_NAME=CaminoSeguro.Api
ENV APP_DLL=${APP_NAME}.dll \
    ASPNETCORE_URLS=http://+:8080 \
    ASPNETCORE_ENVIRONMENT=Production
WORKDIR /app
COPY --from=build /app/publish .
# Las imágenes oficiales de .NET traen el usuario sin privilegios "app".
USER app
EXPOSE 8080
ENTRYPOINT ["sh", "-c", "exec dotnet \"$APP_DLL\""]
