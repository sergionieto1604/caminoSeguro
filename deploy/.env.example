# Copiar como ".env" (NUNCA subir .env a GitHub).
# Contraseña del usuario sa: mínimo 8 caracteres con mayúscula, minúscula, número y símbolo.
SQL_SA_PASSWORD=CambiaEsto_2026!
# Clave para firmar los JWT: mínimo 32 caracteres aleatorios.
# Generar en PowerShell: [Convert]::ToBase64String((1..48 | % { Get-Random -Max 256 }))
JWT_KEY=CAMBIAR_POR_UNA_CLAVE_ALEATORIA_DE_MAS_DE_32_CARACTERES
# URL pública con la que se abre la app (para CORS). Ej: http://20.55.10.4
PUBLIC_URL=http://localhost
# Nombre del proyecto .NET (el .csproj sin extensión)
API_APP_NAME=CaminoSeguro.Api
